# Copy this file to .env and fill in real values before running docker compose.
# Coolify: set these as the resource's environment variables instead.

# SMTP relay used to deliver contact-form submissions. Works with Gmail
# (generate an App Password at https://myaccount.google.com/apppasswords)
# or any other SMTP provider.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Where contact-form submissions are sent.
CONTACT_RECIPIENT_EMAIL=nabhandanial@gmail.com

# Origin allowed to call the API directly - only relevant if the frontend
# is ever served from a different domain than the backend.
FRONTEND_ORIGIN=http://localhost:5173

# Host port the site is published on (behind Coolify's own reverse proxy
# this can usually stay at its default).
APP_PORT=8081

# Secret required (as the X-Admin-Token header) to delete a review via
# DELETE /api/reviews/{id}. Leave empty to disable deletion entirely.
REVIEWS_ADMIN_TOKEN=
